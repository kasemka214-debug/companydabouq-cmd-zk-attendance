APP_NAME="حضور البصمة"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://bio.example.com
APP_LOCALE=ar

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zk_attendance
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── إعدادات الأجهزة ──────────────────────────────────────────────
# المنطقةُ الزمنية التي تُفسَّر بها طوابعُ الأجهزة (الأجهزة ترسل وقتَها المحلي)
ZK_DEVICE_TIMEZONE=Asia/Kuwait
# رقمُ المنطقة الذي يُدفع إلى الجهاز في المصافحة (الكويت = 3)
ZK_TIMEZONE_OFFSET=3
# ثوانٍ بين استعلامَي الجهاز عن الأوامر
ZK_POLL_DELAY=30
# ثوانٍ قبل إعادة المحاولة بعد خطأ
ZK_ERROR_DELAY=60
# أيامُ الاحتفاظ بالطلبات الخام (للتشخيص)
ZK_RAW_RETENTION_DAYS=30
# أقصى عددِ طلباتٍ في الدقيقة لكل جهاز
ZK_RATE_LIMIT=120

# ── صور البصمات ──────────────────────────────────────────────────
# استقبالُ لقطة الكاميرا مع كل بصمة. والصورةُ عشراتُ الكيلوبايتات،
# فعشرون جهازاً بخمسين بصمةً يومياً تكتب نحوَ جيجابايتٍ في الشهر.
ZK_PHOTOS=true
# أيامُ الاحتفاظ بالصور — صفرٌ يعني بلا حذف. والحذفُ لا يمسّ البصمة.
ZK_PHOTO_RETENTION_DAYS=0
