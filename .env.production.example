# ═══════════════════════════════════════════════════════════════════
#  بياناتُ الاتصال بقاعدة الإنتاج — لسحب النسخ الاحتياطية وحدَه.
#
#  انسخ هذا الملفَّ إلى `.env.production` بجانبه واملأه من لوحة
#  Laravel Cloud ← التطبيق ← Database.
#
#  **و`.env.production` مستثنىً من git** (القاعدةُ `.env.*` في
#  `.gitignore`)، فلا يُدفع ولا يدخل أيَّ ملفٍّ مضغوط. ولا تُكتب هذه
#  البياناتُ في محادثةٍ ولا رسالةٍ ولا تذكرة.
# ═══════════════════════════════════════════════════════════════════

# مفتاحُ التشفير يومَ النسخة — يُحفظ بجانبها في ملفٍّ منفصل،
# فبدونه لا يُقرأ ما شُفّر به بعد الاستعادة.
APP_KEY=

DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
